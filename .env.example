# Path to the SQLite database file (relative paths resolve from src/db/)
DATABASE_URL=file:./dev.db
# HMAC key for session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-before-deploying
# Secret used to protect /api/cron when triggering the scheduled job over HTTP
CRON_SECRET=change-me-too
# Business timezone used for "today", due dates and the scheduled job
APP_TIMEZONE=Africa/Nairobi
# Set to 1 ONLY if serving production over plain HTTP (e.g. an internal LAN test box)
INSECURE_COOKIES=0
# AI prospecting (Claude API with web search + web fetch). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Set to 1 to return labelled sample results instead of calling the API (demos/tests)
AI_MOCK=0
