{
  "name": "pac-crm-next",
  "version": "1.0.0",
  "private": true,
  "description": "PAC CRM — client relationship management for Priority Activator Consulting",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:wipe": "tsx scripts/wipe.ts",
    "db:reset": "npm run db:wipe && drizzle-kit push --force && npm run db:seed",
    "cron": "tsx scripts/cron.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "docx": "9.7.2",
    "drizzle-orm": "^0.45.3",
    "exceljs": "4.4.0",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
